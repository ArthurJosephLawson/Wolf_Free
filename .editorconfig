root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.rs]
indent_size = 4
max_line_length = 100

[*.{json,jsonc,yml,yaml,toml}]
indent_size = 2

[*.md]

trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{png,ico,jpg,jpeg,gif,webp,woff,woff2,ttf,sqlite,sqlite3}]
insert_final_newline = unset
trim_trailing_whitespace = unset
