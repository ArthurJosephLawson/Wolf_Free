{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wolf",
  "version": "0.3.1",
  "identifier": "dev.wolf.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:5273",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Wolf",
        "url": "index.html",
        "width": 1180,
        "height": 760,
        "minWidth": 880,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "decorations": true,
        "visible": false,
        "focus": true,
        "dragDropEnabled": false
      },
      {
        "label": "companion",
        "title": "Wolf Companion",
        "url": "companion.html",
        "width": 132,
        "height": 148,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "x": 320,
        "y": 180
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": false,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/44x44.png",
      "icons/128x128.png",
      "icons/icon.png"
    ],
    "category": "Productivity",
    "shortDescription": "Local-first productivity companion",
    "longDescription": "Wolf is a local-first desktop companion: tasks, habits, calendar and a focus timer, with a wolf that keeps you company. All data stays on your machine.",
    "copyright": "Copyright (c) 2026 ScriptMonks (Arthur Joseph Lawson / Monk_Mango)",
    "publisher": "ScriptMonks",
    "licenseFile": "../LICENSE",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1"
        ]
      }
    }
  }
}
